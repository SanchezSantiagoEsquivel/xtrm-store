# Wompi (pasarela de pagos) — https://comercios.wompi.co
# Sandbox: usa las llaves que empiezan con pub_test_ / test_integrity_
# Producción: usa las que empiezan con pub_prod_ / prod_integrity_

# Pública, se expone en el frontend (Vite la incluye en el bundle)
VITE_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Secreta, solo la usa la función serverless en api/wompi-integrity.js.
# NUNCA debe tener el prefijo VITE_ ni llegar al bundle del navegador.
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx

# Webhook de aviso de pedidos (api/wompi-webhook.js) — se dispara cuando Wompi
# aprueba un pago y manda un correo con los datos del pedido.

# "Secreto de eventos" de Wompi (comercios.wompi.co → Configuración → Secretos).
# Es distinto al WOMPI_INTEGRITY_SECRET de arriba.
WOMPI_EVENTS_SECRET=events_xxxxxxxxxxxxxxxxxxxxxxxx

# API key de https://resend.com (plan gratis alcanza para empezar)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# A dónde llega el aviso de "entró un pedido nuevo"
ORDER_NOTIFICATION_EMAIL=xtrmcorps@gmail.com
