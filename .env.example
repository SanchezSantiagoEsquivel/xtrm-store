# Wompi (pasarela de pagos) — https://comercios.wompi.co
# Sandbox: usa las llaves que empiezan con pub_test_ / test_integrity_
# Producción: usa las que empiezan con pub_prod_ / prod_integrity_

# Pública, se expone en el frontend (Vite la incluye en el bundle)
VITE_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Secreta, solo la usa la función serverless en api/wompi-integrity.js.
# NUNCA debe tener el prefijo VITE_ ni llegar al bundle del navegador.
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
